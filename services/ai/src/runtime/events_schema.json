{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Event Schema",
  "description": "Unified event format for all Phase 2 runtime collectors (eBPF, mitmproxy, DTrace, ETW)",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "source",
    "event_type",
    "confidence",
    "collector_version",
    "sandbox_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "UUID v4 for event deduplication"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in nanoseconds"
    },
    "source": {
      "type": "string",
      "enum": ["ebpf", "dtrace", "mitmproxy", "memory", "etw"],
      "description": "Collector that produced this event"
    },
    "event_type": {
      "type": "string",
      "enum": ["syscall", "network", "file_access", "memory_op"],
      "description": "Category of runtime event"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score (0-1). Used for filtering noise."
    },
    "collector_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
      "description": "Semantic version of the collector. Enables determinism debugging."
    },
    "sandbox_id": {
      "type": "string",
      "description": "UUID linking event to execution sandbox. Critical for determinism traces."
    },
    "related_static_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to Phase 1 vulnerability IDs that this event may support/refute"
    },
    "details": {
      "oneOf": [
        {
          "$ref": "#/definitions/syscall_event"
        },
        {
          "$ref": "#/definitions/network_event"
        },
        {
          "$ref": "#/definitions/file_access_event"
        },
        {
          "$ref": "#/definitions/memory_event"
        }
      ],
      "description": "Event-specific payload"
    },
    "determinism_metadata": {
      "type": "object",
      "description": "Optional metadata for determinism analysis",
      "properties": {
        "ordering_bucket": {
          "type": "integer",
          "description": "50ms time bucket for ordering tolerance (±50ms allowed)"
        },
        "hash": {
          "type": "string",
          "description": "SHA256 of event content (excluding timestamp)"
        }
      }
    }
  },
  "definitions": {
    "syscall_event": {
      "type": "object",
      "required": ["syscall_number", "syscall_name"],
      "properties": {
        "syscall_number": {
          "type": "integer"
        },
        "syscall_name": {
          "type": "string",
          "description": "e.g., open, execve, clone"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Syscall arguments (sanitized)"
        },
        "return_value": {
          "type": "integer"
        },
        "errno": {
          "type": "integer"
        },
        "process_name": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "uid": {
          "type": "integer"
        }
      }
    },
    "network_event": {
      "type": "object",
      "required": ["direction", "protocol"],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["inbound", "outbound"]
        },
        "protocol": {
          "type": "string",
          "enum": ["tcp", "udp", "tls"]
        },
        "src_ip": {
          "type": "string"
        },
        "src_port": {
          "type": "integer"
        },
        "dst_ip": {
          "type": "string"
        },
        "dst_port": {
          "type": "integer"
        },
        "method": {
          "type": "string",
          "description": "HTTP verb (GET, POST, etc)"
        },
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "description": "Request/response body (sanitized)"
        },
        "response_code": {
          "type": "integer"
        }
      }
    },
    "file_access_event": {
      "type": "object",
      "required": ["operation", "path"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["open", "read", "write", "delete"]
        },
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["r", "w", "rw"]
        },
        "size": {
          "type": "integer"
        },
        "permission_denied": {
          "type": "boolean"
        }
      }
    },
    "memory_event": {
      "type": "object",
      "required": ["operation", "address"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["alloc", "free", "access", "overflow"]
        },
        "address": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "data_type": {
          "type": "string"
        },
        "out_of_bounds": {
          "type": "boolean"
        },
        "backtrace": {
          "type": "string",
          "description": "Call stack (sanitized)"
        }
      }
    }
  }
}
