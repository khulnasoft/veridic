# Example .env file for Phase 0 development

# OpenAI API Key (required)
OPENAI_API_KEY=your-api-key-here

# AI Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_MODEL=gpt-4o
AI_SERVICE_MAX_TOKENS=2048
AI_SERVICE_TEMPERATURE=0.2

# gRPC Configuration
GRPC_SERVER_URL=localhost:50051

# Rust Logging
RUST_LOG=info
